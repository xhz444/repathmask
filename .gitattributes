# Android shell scripts must stay LF; CRLF breaks mksh/toybox parsing.
* text=auto
*.sh text eol=lf
*.conf text eol=lf
*.prop text eol=lf
*.c text eol=lf
*.h text eol=lf
Makefile text eol=lf
Kbuild text eol=lf
*.yml text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.gitattributes text eol=lf
*.gitignore text eol=lf
